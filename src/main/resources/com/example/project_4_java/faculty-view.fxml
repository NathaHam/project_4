<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.project_4_java.FacultyController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
        <ListView fx:id="facultyListView" onMouseClicked="#facultySelected" VBox.vgrow="ALWAYS" />
        <Button onAction="#loadFaculties" text="Refresh" />
    </VBox>

    <GridPane hgap="10.0" vgap="10.0" prefWidth="320.0">
        <columnConstraints>
            <ColumnConstraints minWidth="75.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <Label text="First Name" GridPane.rowIndex="0" />
        <TextField fx:id="firstNameTextField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Last Name" GridPane.rowIndex="1" />
        <TextField fx:id="lastNameTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Department" GridPane.rowIndex="2" />
        <TextField fx:id="departmentTextField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Button maxWidth="Infinity" onAction="#addFacultyButtonClicked" text="Add Faculty" GridPane.columnIndex="1" GridPane.rowIndex="7" />
        <Button fx:id="updateFacultyButton" disable="true" maxWidth="Infinity" onAction="#updateFacultyButtonClicked" text="Update Selected faculty" GridPane.columnIndex="1" GridPane.rowIndex="8" />
        <Button maxWidth="Infinity" onAction="#clearForm" text="Clear" GridPane.columnIndex="1" GridPane.rowIndex="9" />
    </GridPane>
</HBox>
